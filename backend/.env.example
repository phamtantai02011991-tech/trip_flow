# ============================================================
# TripFlow backend — biến môi trường mẫu
# Sao chép thành `.env` (dev) hoặc khai báo trong secret manager (production).
# ============================================================

PROJECT_NAME="TripFlow - Vietnam Travel Discovery API"
API_V1_STR="/api/v1"

# development | staging | production
ENVIRONMENT="development"

# BẮT BUỘC đổi ở production; sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="tripflow_super_secret_jwt_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL 15 (production) hoặc SQLite (dev)
DATABASE_URL="sqlite:///./tripflow.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/tripflow"

# CORS: danh sách origin thật, phân tách bằng dấu phẩy. Production bắt buộc khai báo.
# CORS_ORIGINS="https://admin.tripflow.vn,https://tripflow.vn"

# ---------- Dữ liệu khởi tạo ----------
# 1 = seed 5 tài khoản DEMO (CHỈ dùng ở dev). Production PHẢI để 0.
SEED_DEMO=1
# Production: bắt buộc admin bật 2FA trước khi dùng API quản trị
REQUIRE_ADMIN_2FA=0
# Tài khoản quản trị đầu tiên khi SEED_DEMO=0
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# ---------- OTP / SMS ----------
# Chỉ bật 1 ở dev để API trả `debug_otp`; production phải 0.
DEV_OTP_ENABLED=0
DEV_OTP=""
# simulator (dev) | esms (production)
SMS_PROVIDER="simulator"
ESMS_API_KEY=""
ESMS_SECRET_KEY=""
ESMS_BRANDNAME="TripFlow"

# Crawler Google Maps: để 0 ở production (vi phạm điều khoản Google)
ENABLE_GOOGLE_CRAWLER=0

# ---------- Gemini (AI Planner & Assistant) ----------
GEMINI_API_KEY=""
GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL_PLANNER=""
GEMINI_MODEL_CHAT=""
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS_PLANNER=8192
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75

# ---------- Goong Maps ----------
GOONG_API_KEY=""
GOONG_MAPTILES_KEY=""
GOONG_BASE_URL="https://rsapi.goong.io"

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Bản đồ / quota ----------
MAPS_PROVIDER="goong"
MAPS_DAILY_BUDGET_LIMIT=500
PLACES_CACHE_TTL_HOURS=24

# ---------- Nghiệp vụ ----------
CORRIDOR_RATE_LIMIT="10/minute"
DEFAULT_CORRIDOR_RADIUS_KM=2.0
MAX_CORRIDOR_RADIUS_KM=10.0
MAX_ITINERARY_STOPS=20
AI_PLANS_PER_DAY=5
