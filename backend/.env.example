PROJECT_NAME="TripFlow - Vietnam Travel Discovery API"
API_V1_STR="/api/v1"
SECRET_KEY="tripflow_super_secret_jwt_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL 15 thuần (không dùng PostGIS ở giai đoạn MVP) hoặc SQLite fallback
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripflow"

# Goong Maps API (Thay thế Google Maps tối ưu cho Việt Nam)
GOONG_API_KEY=""
GOONG_MAPTILES_KEY=""
GOONG_BASE_URL="https://rsapi.goong.io"

# Cloudinary Image CDN (Tối ưu hóa ảnh thumbnail w_400,h_300 & chi tiết w_1200)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate Limiting (slowapi) bảo vệ API Tìm đường / Corridor Search
CORRIDOR_RATE_LIMIT="10/minute"
DEFAULT_CORRIDOR_RADIUS_KM=2.0
MAX_CORRIDOR_RADIUS_KM=10.0
MAX_ITINERARY_STOPS=20
MAPS_DAILY_BUDGET_LIMIT=500
