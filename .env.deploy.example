# ============================================================
# TripFlow — biến môi trường cho `docker compose`
# Sao chép thành `.env` ở thư mục gốc rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file `.env`.
# ============================================================

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_thanh_mat_khau_manh
POSTGRES_DB=tripflow

# --- Backend ---
ENVIRONMENT=production
# Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=doi_thanh_chuoi_ngau_nhien_48_ky_tu
BACKEND_PORT=8000
ADMIN_PORT=8080

# Production: 0 = không seed tài khoản demo
SEED_DEMO=0
# Bật sau khi admin đã thiết lập TOTP; nếu bật ngay sẽ chặn admin chưa có 2FA.
REQUIRE_ADMIN_2FA=0
# Tài khoản quản trị đầu tiên (mật khẩu >= 12 ký tự)
BOOTSTRAP_ADMIN_EMAIL=admin@congty.vn
BOOTSTRAP_ADMIN_PASSWORD=MatKhauRatManh123!

# Domain thật của admin web (dùng khi tách domain; nếu dùng nginx cùng domain có thể để mặc định)
CORS_ORIGINS=http://localhost:8080

# --- SMS OTP (bắt buộc để đăng nhập/đăng ký hoạt động ở production) ---
SMS_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=TripFlow

# Crawler Google Maps: để 0 (mặc định) vì lý do điều khoản/pháp lý
ENABLE_GOOGLE_CRAWLER=0

# --- Bên thứ ba ---
GEMINI_API_KEY=
GOONG_API_KEY=
GOONG_MAPTILES_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAPS_DAILY_BUDGET_LIMIT=1000
